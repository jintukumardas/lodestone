# Lodestone environment.
# Copy to .env and edit before running `docker compose up`.
# .env is gitignored.

# --- ClickHouse credentials ---
# All three must be set; there are no defaults in the binaries.
CLICKHOUSE_DB=lodestone
CLICKHOUSE_USER=lodestone
CLICKHOUSE_PASSWORD=change-me-before-anything-leaves-localhost

# --- HTTP API auth ---
# Required by lodestone-api at startup. The MCP server forwards the same token.
# Generate something opaque: `openssl rand -hex 32`.
LODESTONE_API_TOKEN=change-me-before-anything-leaves-localhost

# --- Endpoints (defaults match docker-compose) ---
CLICKHOUSE_URL=http://127.0.0.1:8123
NATS_URL=nats://127.0.0.1:4222
LODESTONE_API_URL=http://127.0.0.1:7700
